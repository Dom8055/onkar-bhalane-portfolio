# ==============================================================================
# ONKAR BHALANE PORTFOLIO — ENVIRONMENT CONFIGURATION
# ==============================================================================

# App
APP_NAME="Onkar Bhalane Portfolio API"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB (Use MongoDB Atlas URI in production)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=onkar_portfolio
# Set to true only for local dev/CI when MongoDB is not installed locally
MONGODB_FALLBACK_MOCK=true

# JWT Authentication (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
JWT_REFRESH_SECRET_KEY=change-this-to-another-long-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Seed Credentials (override in production)
ADMIN_EMAIL=obhalane@gmail.com
ADMIN_NAME=Onkar Bhalane
ADMIN_PASSWORD=ChangeMe@Onkar2026!

# Media Storage (local uploads/ by default; optional Cloudinary)
UPLOAD_DIR=../uploads
MAX_UPLOAD_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service (SMTP — leave blank to log emails to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=obhalane@gmail.com
CONTACT_NOTIFY_EMAIL=obhalane@gmail.com

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CONTACT_RATE_LIMIT_PER_HOUR=10
